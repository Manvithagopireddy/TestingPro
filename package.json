{
  "name": "rest-api-testing-framework",
  "version": "1.0.0",
  "description": "Security-maintained API testing portfolio with Jest, Supertest, Cucumber, Playwright and automated CI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "npm run test:jest",
    "test:jest": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:cucumber": "cucumber-js --tags \"not @manual\"",
    "test:cucumber:functional": "cucumber-js --tags \"@functional and not @manual\"",
    "test:cucumber:regression": "cucumber-js --tags \"@regression and not @manual\"",
    "test:cucumber:smoke": "cucumber-js --tags \"@smoke and not @manual\"",
    "test:cucumber:manual": "cucumber-js --tags \"@manual\" --dry-run",
    "test:cucumber:html": "cucumber-js --tags \"not @manual\" --format html:reports/cucumber-report.html",
    "test:playwright": "playwright test --config=playwright.config.cjs",
    "test:ci": "npm run test:coverage && npm run test:cucumber && node scripts/sql-validation.js",
    "test:all": "npm run test:ci && npm run test:playwright",
    "validate:db": "node scripts/sql-validation.js",
    "lint": "eslint src tests/playwright",
    "format:check": "prettier --check .prettierrc.json",
    "security:audit": "npm audit --audit-level=moderate",
    "security:runtime": "npm audit --omit=dev --audit-level=moderate"
  },
  "keywords": [
    "qa",
    "sdet",
    "api-testing",
    "postman-collection",
    "playwright",
    "cucumber",
    "jest",
    "github-actions"
  ],
  "author": "Gopireddy Manvitha",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2"
  }
}
