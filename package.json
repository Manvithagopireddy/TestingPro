{
  "name": "rest-api-testing-framework",
  "version": "1.0.0",
  "description": "QA/SDET Portfolio: REST API Testing & Validation Framework — Task Manager API with Postman, Newman, and GitHub Actions CI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "newman": "node scripts/run-newman.js",
    "test": "npm run seed && npm run newman",
    "test:jest": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:verbose": "npm run seed && npm run newman -- --verbose",
    "test:cucumber": "cucumber-js --tags \"not @manual\"",
    "test:cucumber:functional": "cucumber-js --tags \"@functional and not @manual\"",
    "test:cucumber:regression": "cucumber-js --tags \"@regression and not @manual\"",
    "test:cucumber:smoke": "cucumber-js --tags \"@smoke and not @manual\"",
    "test:cucumber:manual": "cucumber-js --tags \"@manual\" --dry-run",
    "test:cucumber:html": "cucumber-js --tags \"not @manual\" --format html:reports/cucumber-report.html",
    "test:ci": "npm run seed && npm run newman && node scripts/sql-validation.js",
    "test:all": "npm run seed && npm run newman && npm run test:jest && npm run test:cucumber && node scripts/sql-validation.js",
    "validate:db": "node scripts/sql-validation.js"
  },
  "keywords": [
    "qa",
    "sdet",
    "api-testing",
    "postman",
    "newman",
    "rest-api",
    "portfolio"
  ],
  "author": "QA Engineer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.22.11",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2"
  }
}
